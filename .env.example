PORT=3000
BATCH_SIZE=500

# One connection string per shard, comma separated, in shard order (0,1,2)
SHARD_URLS=postgres://app:app@localhost:5433/orders_shard0,postgres://app:app@localhost:5434/orders_shard1,postgres://app:app@localhost:5435/orders_shard2

# gcs = real Google Cloud Storage using ADC (no credentials here)
STORAGE_DRIVER=gcs
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=your-bucket-name

# Only for the local emulator (Plan B). Leave commented for real GCS.
# STORAGE_EMULATOR_HOST=http://localhost:4443